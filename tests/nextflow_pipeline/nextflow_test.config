params {
    // Base paths
    root_outdir   = "${env('HOME')}/Documents/mlp/tests/output"
    scripts_dir   = "${env('HOME')}/Documents/mlp/tests/scripts"
    mlp           = "${env('HOME')}/Documents/mlp/target/release/mlp"
    pixi_toml     = "${env('HOME')}/Documents/mlp/pixi.toml"

    // Simulated trials dimensions
    n_years                = [2, 5]
    n_sites                = [3]
    n_treatments           = [2]
    n_entries              = [10, 50]
    n_replications         = [3]
    n_hidden_layers_trials = [1, 2, 3, 4, 5]

    // Simulated genotype and phenotype data
    data_types         = ["CONTINUOUS", "BINARY"]
    n_observations     = [500, 1000]
    n_features         = [1000, 10000]
    n_hidden_layers_gp = [1, 2]

    // Dataset directories
    trials_agridat_dir                          = "${env('HOME')}/Documents/mlp/tests/datasets/agridat_TEST"
    gp_azodi2019_dir                            = "${env('HOME')}/Documents/mlp/tests/datasets/azodi_2019_TEST"
    remotesensing_farag_2024_dir                = "${env('HOME')}/Documents/mlp/tests/datasets/farag_2024"
    remotesensing_farag_2024_fname_trait_csv    = "${params.remotesensing_farag_2024_dir}/constant_agronomic_traits_2021.csv"
    remotesensing_farag_2024_trait              = "Yield"
    remotesensing_farag_2024_dates              = ["06142021"]

    // Model exclusions
    exclude_lm     = "TRUE"
    exclude_lmer   = "TRUE"
    exclude_sommer = "TRUE"
    exclude_asreml = "FALSE"

    // Analysis parameters
    n_reps                            = 5
    n_folds                           = 10
    n_iterations_linear               = 10000
    n_burnin_iterations_linear        = 1000
    models_linear                     = "BRR,BayesA,BayesB,BayesC"
    n_estimators_trees                = 1000
    max_depth_trees                   = 3
    learning_rate_trees               = 0.1
    early_stopping_rounds_trees       = 10
    optim_n_estimators_trees          = "100,1000"
    optim_max_depth_trees             = "2,3,5,7"
    optim_learning_rate_trees         = "0.01,0.1"
    optim_subsample_trees             = "0.25,0.50,1.00"

    seed = 42
    verbose   = "TRUE"
}

executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10/1s'
}

executor {
    name = 'local'
    cpus = 24
    memory = '100 GB'
}

process {
    executor = 'slurm'
    clusterOptions = '--account=dbiof2'
    // executor = 'local'

    // Defaults
    queue  = 'batch'
    cpus   = 4
    memory = '50 GB'
    time   = '7d'

    withLabel: 'gpu' {
        queue  = 'gpu'
        cpus   = 1
        memory = '100 GB'
        time   = '7d'
        clusterOptions = '--account=dbiof2 --gres=gpu:h100:1'
    }

    // Critical: hook the Pixi environment into every Slurm job step
    beforeScript = 'eval "$(pixi shell-hook)"' // Will use ${HOME}/Documents/mlp/pixi.toml
}

report {
    enabled = true
    file = 'logs/report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'logs/timeline.txt'
    overwrite = true
}

trace {
    enabled = true
    file = 'logs/trace.txt'
    overwrite = true
}

dag {
    enabled = true
    file = 'logs/dag.dot'
    overwrite = true
}